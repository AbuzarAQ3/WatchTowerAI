SECRET_KEY=django-secret-key

DEBUG=False

ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://127.0.0.1

SOCIALACCOUNT_ENABLED=False
GOOGLE_CLIENT_ID=google-client-key
GOOGLE_CLIENT_SECRET=google-client-secret-key

# database selection
POSTGRES_DB=False
# POSTGRES_DB=False then sqlite3 will be used otherwise ->
# postgres setup
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=django.db.backends.postgresql
DB_NAME=staging.JourneylyAI.db
DB_USER=postgres
DB_PASSWORD=ABU

